# DOITUNG — environment template. Copy to .env and fill in values for local dev.

# --- Database (Laragon defaults) -------------------------------------------------
DATABASE_URL="mysql://root:@localhost:3306/okrsdoitung"

# --- Auth -----------------------------------------------------------------------
JWT_SECRET="dev-only-secret-change-me"
JWT_EXPIRES_IN="7d"

# --- App ------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- AI + SAR add-on (Phase 1) -------------------------------------------------
# Required only when a school has aiEnabled / sarEnabled in FeatureFlag.
# Get a key from https://openrouter.ai/keys
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemini-2.5-flash"
# Optional override; defaults to https://openrouter.ai/api/v1
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
