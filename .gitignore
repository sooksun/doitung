# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local
.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
/prisma/migrations/

# uploaded SAR PDFs (mounted as Docker volume in prod; never committed)
/public/uploads/

# TSQMn redesign — scratch folder of assets extracted from the prototype bundle
/.design-extract/

# PII / debug artifacts from seed scripts — keep these off git.
# (the seeder reads de-list.json; regenerate locally via scripts/read-de-list.py)
/scripts/de-list.json
/scripts/*-output.txt
/scripts/school-*.txt
/scripts/*credentials*.xlsx
/scripts/*credentials*.csv

# --- Local editor / agent scratch (not part of the app) ---
/.claude/

# --- DB dumps, backups, exports (generated locally; never commit) ---
/backup/
/exports/

# --- Design handoff prototype (standalone HTML/CSS/JSX, not wired into the build) ---
/de-soar/

# --- Binary / document artifacts (no source of these is tracked; public/ images stay safe) ---
*.zip
*.pdf
*.docx
*.html

# --- Root-level scratch: SQL pastes, notes, sample images, ad-hoc reports ---
/*.txt
/*.jpg
/*.jpeg
/TEST_RESULTS.md

# --- docs/: keep .md sources, drop generated binaries ---
/docs/*.png
